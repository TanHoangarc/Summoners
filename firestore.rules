rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Monsters collection: read and write allowed for applet
    match /monsters/{monsterId} {
      allow read, write: if true;
    }
    
    // Counters collection: read and write allowed for custom counters
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Siege Defenses collection: read and write allowed for saved defense formations
    match /siege_defenses/{defenseId} {
      allow read, write: if true;
    }
  }
}
