      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "awakenedName": { "type": "string" },
        "element": { "type": "string" },
        "naturalStars": { "type": "number" },
        "avatarUrl": { "type": "string" },
        "role": { "type": "string" },
        "baseSpeed": { "type": "number" },
